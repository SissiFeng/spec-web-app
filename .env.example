# Database password (used by both postgres and backend)
DB_PASSWORD=changeme

# JWT secret for auth tokens (change in production!)
JWT_SECRET=change-this-secret-in-production

# Port to expose the app on (default: 80)
PORT=80

# ─── Production only (docker-compose.prod.yml) ───────────────────
# GHCR image prefix — matches your GitHub repo (lowercase)
# Example: if repo is github.com/sissifeng/spec-web-app
IMAGE_PREFIX=sissifeng/spec-web-app
